    <string name="dpi_pill">DPI · %1$s</string>
    <string name="dpi_title">DPI bypass</string>
    <string name="dpi_intro">Cuts the first packets of every connection to your server into pieces that traffic inspection cannot match. No root needed.</string>
    <string name="dpi_mode_off">Off</string>
    <string name="dpi_mode_off_desc">Connect as usual.</string>
    <string name="dpi_mode_light">Light</string>
    <string name="dpi_mode_light_desc">Splits the first packet inside the server name. Fast, and rarely noticed by the network.</string>
    <string name="dpi_mode_standard">Standard</string>
    <string name="dpi_mode_standard_desc">Splits the TLS record and the packet inside the server name. The usual choice.</string>
    <string name="dpi_mode_strong">Strong</string>
    <string name="dpi_mode_strong_desc">Standard, plus the first segment delivered out of order, for inspectors that reassemble the stream.</string>
    <string name="dpi_mode_custom">Custom</string>
    <string name="dpi_mode_custom_desc">Your own recipe built from split, tlsrec, oob, disorder, fake and delay.</string>
    <string name="dpi_custom_hint">tlsrec=sni+2; split=1,sni+2</string>
